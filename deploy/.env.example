# Copy to deploy/.env on the server and fill in every blank:
#   cp .env.example .env && nano .env
# deploy/.env is gitignored. Never commit the real one.

# --- Domains and TLS ---
DOMAIN=deadlock.sbs
API_DOMAIN=api.deadlock.sbs
# Let's Encrypt emails this address before certificates expire
ACME_EMAIL=

# Browser origins allowed to call the backend (comma-separated)
FRONTEND_URL=https://deadlock.sbs

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses all database security. Server only, never in a VITE_ setting.
SUPABASE_SERVICE_ROLE_KEY=
# Optional with Supabase's newer signing keys: the backend falls back to
# asking Supabase to verify each login when this is empty or does not match.
SUPABASE_JWT_SECRET=

# --- Backend ---
# openssl rand -hex 32
ADMIN_SECRET=
MATCH_TIMEOUT_MS=1800000
RECONNECT_GRACE_MS=45000
# Submissions judged at once. "auto" runs one per vCPU, so resizing the
# droplet raises it with nothing to change. A number pins it.
JUDGE0_MAX_PARALLEL_RUNS=auto
BOT_ENABLED=true
BOT_DEFAULT_DIFFICULTY=medium
# Seconds a duel room (friend invite link) lives without activity
ROOM_TTL_SECONDS=10800

# --- Admin review page (/admin): your account's email and/or user id ---
ADMIN_EMAILS=
ADMIN_USER_IDS=

# --- Daily ranked hour (UTC, HH:MM, or "off"); 15:00 UTC is 8:30 PM IST ---
RANKED_HOUR_UTC=15:00
RANKED_HOUR_MINUTES=60

# --- Alerts: "someone is waiting in ranked", "ranked hour is on" ---
# Browser push. Generate a pair once on the server:
#   docker compose exec backend npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Discord: channel settings -> Integrations -> Webhooks -> New webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# Optional role to ping (Developer Mode on, right-click the role -> Copy Role ID)
DISCORD_ROLE_ID=

# Ghost duels (race a recorded ranked win)
GHOST_ENABLED=true

# --- Frontend build (baked into the public JavaScript, so public values only) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SOCKET_URL=https://api.deadlock.sbs

# --- Judge0 internals (must match deploy/judge0.conf) ---
POSTGRES_DB=judge0
POSTGRES_USER=judge0
# openssl rand -hex 24
REDIS_PASSWORD=
