# ============================================================
# Edge routing + automatic TLS
# ============================================================
# Caddy obtains and renews Let's Encrypt certificates automatically, which is
# why there is no certbot/nginx in this stack.
#
# Requires DNS A records pointing at this server BEFORE the first boot, or the
# certificate challenge fails:
#
#   deadlock.sbs      -> <server ip>
#   www.deadlock.sbs  -> <server ip>
#   api.deadlock.sbs  -> <server ip>
# ============================================================

{
	# Where Let's Encrypt sends expiry warnings.
	email {$ACME_EMAIL}
}

# Redirect the www host to the apex domain so there is one canonical origin.
# The frontend is built with a single origin in mind, and a second origin would
# also need adding to FRONTEND_URL for CORS.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Frontend: the built SPA.
{$DOMAIN} {
	encode gzip zstd

	# Invite links (/duel/CODE) and shared results (/r/<match id>, plus its
	# card image) come from the backend. It serves the app's own index.html
	# with the link preview filled in (who is inviting, who beat whom),
	# because Discord and other unfurlers read the HTML and never run the app.
	# If it cannot, the plain app is served, so links still work.
	@invite path_regexp ^/(duel/[A-Za-z0-9]+|r/[0-9a-fA-F-]{36}(/card\.png)?)/?$
	handle @invite {
		reverse_proxy backend:3001 {
			# 404: a backend without invite pages; 5xx: it could not build one
			@no_invite_page status 404 5xx
			handle_response @no_invite_page {
				rewrite * /index.html
				reverse_proxy frontend:80
			}
		}
	}

	handle {
		reverse_proxy frontend:80
	}

	# Backend unreachable: invite and result links still open the app
	handle_errors {
		@invite_fallback path_regexp ^/(duel|r)/
		handle @invite_fallback {
			rewrite * /index.html
			reverse_proxy frontend:80
		}
	}
}

# Backend: REST + Socket.IO.
# Caddy's reverse_proxy upgrades WebSockets transparently, including the
# long-lived Socket.IO connection, so no special configuration is needed here.
{$API_DOMAIN} {
	encode gzip zstd
	reverse_proxy backend:3001
}
